{
    "name": "estebann/planning",
    "type": "project",
    "authors": [
        {
            "name": "Estébann BLANRUE",
            "email": "estebann.blanrue@gmail.com"
        }
    ],
    "require-dev": {
        "symfony/var-dumper": "^8.1",
        "phpunit/phpunit": "^13.2",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "require": {
        "robmorgan/phinx": "^0.16.11",
        "altorouter/altorouter": "^2.0",
        "twig/twig": "^3.27",
        "monolog/monolog": "^3.10",
        "php-di/php-di": "^7.1",
        "phpoffice/phpspreadsheet": "^5.7",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/psr7": "^2.11",
        "relay/relay": "^3.0",
        "minishlink/web-push": "^9.0",
        "sabre/vobject": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\":"src/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "coverage": "env XDEBUG_MODE=coverage phpunit --configuration phpunit.xml.dist --coverage-text --coverage-html coverage/html"
    }
}
